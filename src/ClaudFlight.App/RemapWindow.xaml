<Window x:Class="ClaudFlight.App.RemapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remap" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock x:Name="SlotLabelText" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock x:Name="SlotDeviceText" Foreground="Gray" TextWrapping="Wrap" />
        <TextBlock x:Name="SlotHelpText" TextWrapping="Wrap" Margin="0,6,0,6" FontSize="11" Foreground="#444444" />

        <CheckBox x:Name="UseAsShiftCheck" Margin="0,0,0,6" Checked="UseAsShiftCheck_Changed" Unchecked="UseAsShiftCheck_Changed"
                  Content="Use this as the shift control (hold it to switch to the shifted layer)"
                  ToolTip="While the shift control is held, any control with Shifted mappings uses those instead of its normal ones. Controls without Shifted mappings keep working as normal." />

        <StackPanel x:Name="LayerRow" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Layer:" Width="110" VerticalAlignment="Center" />
            <RadioButton x:Name="NormalLayerRadio" Content="Normal" IsChecked="True" Margin="0,0,12,0" Checked="Layer_Checked" />
            <RadioButton x:Name="ShiftLayerRadio" Content="Shifted (while shift is held)" Checked="Layer_Checked" />
        </StackPanel>
        <TextBlock x:Name="ShiftHintText" TextWrapping="Wrap" FontSize="11" Foreground="#885500" Margin="110,0,0,6" />

        <GroupBox x:Name="OutputsGroup" Header="Currently does" Padding="6">
            <StackPanel>
                <TextBlock x:Name="NoOutputsText" Text="Nothing yet." FontStyle="Italic" Foreground="Gray" />
                <ItemsControl x:Name="OutputsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Button DockPanel.Dock="Right" Content="Remove" Click="RemoveOutput_Click" Padding="6,0" />
                                <Button DockPanel.Dock="Right" Content="Change" Click="EditOutput_Click" Padding="6,0" Margin="0,0,4,0"
                                        ToolTip="Load this into the form below to change it" />
                                <TextBlock Text="{Binding Description}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="AddGroup" Header="Add" Padding="6" Margin="0,8,0,0">
            <StackPanel>
                <DockPanel Margin="0,2">
                    <TextBlock Text="Send:" Width="110" VerticalAlignment="Center" />
                    <ComboBox x:Name="OutputTypeCombo" DisplayMemberPath="Display" SelectionChanged="OutputTypeCombo_SelectionChanged" />
                </DockPanel>
                <DockPanel x:Name="NudgeRow" Margin="0,2">
                    <TextBlock Text="Move it:" Width="110" VerticalAlignment="Center" />
                    <ComboBox x:Name="NudgeCombo" DisplayMemberPath="Display" SelectionChanged="NudgeCombo_SelectionChanged" />
                </DockPanel>
                <DockPanel x:Name="VJoyIdRow" Margin="0,2">
                    <TextBlock Text="vJoy device #:" Width="110" VerticalAlignment="Center" />
                    <TextBox x:Name="VJoyIdBox" Text="1" Width="50" HorizontalAlignment="Left" TextChanged="VJoyIdBox_TextChanged"
                             ToolTip="Which virtual vJoy device (1-16) to write to - almost everyone just uses 1." />
                </DockPanel>
                <DockPanel x:Name="TargetRow" Margin="0,2">
                    <TextBlock x:Name="TargetLabel" Text="Button:" Width="110" VerticalAlignment="Center" />
                    <ComboBox x:Name="TargetCombo" DisplayMemberPath="Display" MaxDropDownHeight="300" />
                </DockPanel>
                <TextBlock x:Name="VJoyLimitText" TextWrapping="Wrap" FontSize="11" Foreground="#885500" Margin="110,0,0,2" />
                <DockPanel x:Name="KeyRow" Margin="0,2">
                    <TextBlock Text="Key:" Width="110" VerticalAlignment="Center" />
                    <ComboBox x:Name="KeyCombo" DisplayMemberPath="Name" MaxDropDownHeight="300" />
                </DockPanel>
                <DockPanel x:Name="ModeRow" Margin="0,2">
                    <TextBlock Text="Behaviour:" Width="110" VerticalAlignment="Center" />
                    <ComboBox x:Name="ModeCombo" DisplayMemberPath="Display" SelectionChanged="ModeCombo_SelectionChanged" />
                </DockPanel>
                <DockPanel x:Name="NudgeAmountRow" Margin="0,2">
                    <TextBlock Text="Amount:" Width="110" VerticalAlignment="Center" />
                    <TextBox x:Name="NudgeAmountBox" Text="50" Width="50" />
                    <TextBlock x:Name="NudgeAmountUnit" Text="% of full travel per second" VerticalAlignment="Center" Margin="6,0,0,0" />
                </DockPanel>
                <DockPanel x:Name="ThresholdRow" Margin="0,2">
                    <TextBlock Text="Press at:" Width="110" VerticalAlignment="Center" />
                    <TextBox x:Name="ThresholdBox" Text="50" Width="50" />
                    <TextBlock Text="% of the way to that end" VerticalAlignment="Center" Margin="6,0,0,0" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="110,6,0,0">
                    <Button x:Name="AddButton" Content="Add" Click="Add_Click" Padding="14,2" />
                    <Button x:Name="CancelEditButton" Content="Cancel" Click="CancelEdit_Click" Padding="14,2" Margin="6,0,0,0" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="KeyboardNote" TextWrapping="Wrap" FontSize="11" Foreground="#B04000" FontWeight="SemiBold" Margin="0,8,0,0"
                   Text="Keyboard keys are switched off right now, so key outputs won't fire. Tick &quot;Keyboard keys on&quot; at the top of the main window (or in the tray menu) when you want them." />
        <Button Content="Close" IsCancel="True" HorizontalAlignment="Right" Padding="14,2" Margin="0,10,0,0" Click="Close_Click" />
    </StackPanel>
</Window>
