<Window x:Class="ClaudFlight.App.BackupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile backups" Width="420" Height="440" MinWidth="320" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="10">
        <TextBlock x:Name="IntroText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Open folder" Click="OpenFolder_Click" Padding="10,2" Margin="0,0,6,0"
                    ToolTip="Show the backup files in File Explorer." />
            <Button x:Name="RestoreButton" Content="Restore" Click="Restore_Click" Padding="12,2" Margin="0,0,6,0" FontWeight="SemiBold" IsEnabled="False"
                    ToolTip="Put the profile back the way it was then. What it is now is backed up first, so you can come back to it." />
            <Button Content="Close" IsCancel="True" Padding="12,2" />
        </StackPanel>
        <Grid>
            <ListBox x:Name="BackupsList" SelectionChanged="BackupsList_SelectionChanged" MouseDoubleClick="BackupsList_MouseDoubleClick"
                     AutomationProperties.Name="Backups" />
            <TextBlock x:Name="NoBackupsText" Foreground="Gray" TextWrapping="Wrap" Margin="8" Visibility="Collapsed"
                       Text="No backups yet. One is made automatically, at most every 10 minutes, whenever the profile changes." />
        </Grid>
    </DockPanel>
</Window>
