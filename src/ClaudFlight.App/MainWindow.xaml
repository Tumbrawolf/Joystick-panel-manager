<Window x:Class="ClaudFlight.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ClaudFlight.App.ViewModels"
        xmlns:conv="clr-namespace:ClaudFlight.App.Converters"
        mc:Ignorable="d"
        Title="ClaudFlight" Height="720" Width="1100">
    <Window.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Buttons get their own menu: keys with a screen (StreamDock) can also take a picture. -->
        <ContextMenu x:Key="AxisControlMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Remap whole axis..." Click="RemapControl_Click" Tag="Whole" FontWeight="SemiBold" />
            <MenuItem Header="Remap + end (as a button)..." Click="RemapControl_Click" Tag="Positive" />
            <MenuItem Header="Remap − end (as a button)..." Click="RemapControl_Click" Tag="Negative" />
            <MenuItem Header="Remap zones (as buttons)..." Click="RemapControl_Click" Tag="Zone" />
            <Separator />
            <MenuItem Header="Hide from Live Monitor" Click="HideControl_Click" />
        </ContextMenu>
        <ContextMenu x:Key="PovControlMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Remap whole hat..." Click="RemapControl_Click" Tag="Whole" FontWeight="SemiBold" />
            <MenuItem Header="Remap ↑ direction..." Click="RemapControl_Click" Tag="Up" />
            <MenuItem Header="Remap → direction..." Click="RemapControl_Click" Tag="Right" />
            <MenuItem Header="Remap ↓ direction..." Click="RemapControl_Click" Tag="Down" />
            <MenuItem Header="Remap ← direction..." Click="RemapControl_Click" Tag="Left" />
            <Separator />
            <MenuItem Header="Hide from Live Monitor" Click="HideControl_Click" />
        </ContextMenu>
        <ContextMenu x:Key="ButtonControlMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Remap..." Click="RemapControl_Click" Tag="Whole" FontWeight="SemiBold" />
            <Separator />
            <MenuItem Header="Set image..." Click="SetButtonImage_Click"
                      Visibility="{Binding HasScreen, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="Clear image" Click="ClearButtonImage_Click" IsEnabled="{Binding HasOwnImage}"
                      Visibility="{Binding HasScreen, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="Set pressed image..." Click="SetPressedButtonImage_Click"
                      Visibility="{Binding HasScreen, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="Clear pressed image" Click="ClearPressedButtonImage_Click" IsEnabled="{Binding HasOwnPressedImage}"
                      Visibility="{Binding HasScreen, Converter={StaticResource BoolToVisibility}}" />
            <Separator Visibility="{Binding HasScreen, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="Hide from Live Monitor" Click="HideControl_Click" />
        </ContextMenu>
        <Style x:Key="ButtonLampStyle" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#DDDDDD" />
            <Setter Property="BorderBrush" Value="#999999" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                    <Setter Property="Background" Value="#3AA655" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Top" Background="#EEEEEE" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="VJoyStatusText" Text="vJoy: checking..." VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="VJoyInstallLink" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed"
                           ToolTip="Opens the download page for vJoy 2.2.2.0 (BrunnerInnovation), a signed build that installs on Windows 10 and 11. The older SourceForge vJoy often fails to install on Windows 11. Install it, run Configure vJoy once, then restart ClaudFlight.">
                    <Hyperlink NavigateUri="https://github.com/BrunnerInnovation/vJoy/releases" RequestNavigate="Hyperlink_RequestNavigate">Get vJoy for Windows 10/11</Hyperlink>
                </TextBlock>
                <Button Content="Refresh Devices" Click="RefreshDevices_Click" Padding="8,2" />
                <CheckBox x:Name="KeyboardInjectionToggle" Content="Keyboard keys on" VerticalAlignment="Center" FontWeight="Bold" Margin="16,0,0,0"
                          Checked="KeyboardInjectionToggle_Changed" Unchecked="KeyboardInjectionToggle_Changed"
                          ToolTip="Lets mappings that send keyboard keys actually press them. Starts OFF every launch, on purpose: simulating real keyboard input is something some anti-cheat software flags, so only turn it on for games where that's fine. Also in the tray icon's menu." />
                <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows" VerticalAlignment="Center" Margin="16,0,0,0"
                          Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed" />
            </StackPanel>
        </Border>

        <!-- Profile bar: quick switch; everything else is on the Profiles tab -->
        <Border DockPanel.Dock="Bottom" Background="#EEEEEE" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Profile:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="QuickProfileCombo" Width="200" ItemsSource="{Binding ProfileNames}" SelectionChanged="QuickProfileCombo_SelectionChanged"
                          ToolTip="Switch profile. Create, rename, copy, delete and set up per-game profiles on the Profiles tab." />
                <TextBlock x:Name="GameStatusBarText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#2E7D32" FontWeight="SemiBold" />
                <TextBlock Text="Changes save automatically." VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray" FontSize="11" />
                <Button x:Name="UndoButton" Content="↶ Undo" Click="Undo_Click" Padding="8,0" Margin="12,0,4,0" IsEnabled="False"
                        ToolTip="Undo the last change to this profile (Ctrl+Z). Older versions are under Backups... on the Profiles tab." />
                <Button x:Name="RedoButton" Content="↷ Redo" Click="Redo_Click" Padding="8,0" IsEnabled="False"
                        ToolTip="Redo the change you just undid (Ctrl+Y)." />
            </StackPanel>
        </Border>

        <TabControl x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">
            <!-- Live Monitor -->
            <TabItem Header="Live Monitor">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="8" Background="#F7F7F7"
                            Visibility="{Binding HiddenDevices.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Hidden devices:" VerticalAlignment="Center" Margin="0,0,8,0" FontStyle="Italic" />
                            <ComboBox x:Name="HiddenDevicesCombo" Width="220" ItemsSource="{Binding HiddenDevices}" DisplayMemberPath="Name"
                                      SelectedIndex="0" Margin="0,0,6,0" />
                            <Button Content="Add back" Click="RestoreDevice_Click" Padding="8,2" ToolTip="Show the selected device again" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceMonitorViewModel}">
                                <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="8" Padding="10" Width="320" VerticalAlignment="Top"
                                        AllowDrop="True" Drop="DeviceCard_Drop">
                                    <StackPanel>
                                        <Grid Cursor="SizeAll" ToolTip="Drag to reorder"
                                              PreviewMouseLeftButtonDown="DeviceCardHeader_PreviewMouseLeftButtonDown"
                                              MouseMove="DeviceCardHeader_MouseMove">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DeviceName}" FontSize="11" Foreground="Gray" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Map all to vJoy..." Click="MapAllToVJoy_Click" Padding="4,0" FontSize="10" Margin="0,0,2,0"
                                                        ToolTip="Map every control on this device that isn't mapped yet onto a vJoy device in one go - axes to the same-named vJoy axis where free, buttons and hats to the next free slots." />
                                                <Button Content="Export" Click="ExportDevice_Click" Padding="4,0" FontSize="10" Margin="0,0,2,0"
                                                        ToolTip="Save just this device's renames, calibration, and mappings to a .json file - for backup or sharing." />
                                                <Button Content="Import" Click="ImportDevice_Click" Padding="4,0" FontSize="10" Margin="0,0,2,0"
                                                        ToolTip="Load a device export (from this or another device) and apply it to this device, merging into your current profile." />
                                                <Button Content="Remove" Click="RemoveDevice_Click" Padding="4,0" FontSize="10" ToolTip="Hide this device" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" Margin="0,0,0,8" />

                                        <StackPanel Margin="0,0,0,8" Visibility="{Binding HasKeyScreens, Converter={StaticResource BoolToVisibility}}">
                                            <CheckBox Content="Show names on keys without a picture" IsChecked="{Binding ShowKeyNames}" Click="KeyScreenOption_Click" FontSize="11"
                                                      ToolTip="Keys with no picture of their own show their name (as typed under the key below) and what they're mapped to." />
                                            <CheckBox Content="Light up keys while pressed" IsChecked="{Binding HighlightPressedKeys}" Click="KeyScreenOption_Click" FontSize="11" Margin="0,2,0,0"
                                                      ToolTip="Keys with no pressed picture of their own get a bright frame while held." />
                                            <CheckBox Content="Show latched keys and the shift layer" IsChecked="{Binding ShowKeyState}" Click="KeyScreenOption_Click" FontSize="11" Margin="0,2,0,0"
                                                      ToolTip="Keys with a latching mapping stay lit while it's latched on, and keys showing names switch to their shifted mappings while the shift control is held." />
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding AxisModeRows}" Margin="0,0,0,8"
                                                      Visibility="{Binding AxisModeRows.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AxisModeRowViewModel}">
                                                    <Grid Margin="0,2"
                                                          ToolTip="How this control's raw movement is exposed - as a continuous axis (optionally under a different axis slot) or as two buttons, one per direction.">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding NativeLabel}" FontSize="11" VerticalAlignment="Center" />
                                                        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:AxisModeRowViewModel.Options}"
                                                                  SelectedItem="{Binding SelectedOption}" FontSize="11"
                                                                  SelectionChanged="AxisMode_SelectionChanged" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding Axes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AxisReadingViewModel}">
                                                    <Grid Margin="0,2" ContextMenu="{StaticResource AxisControlMenu}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="50" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Axis}"
                                                                 BorderThickness="0" Background="Transparent" Padding="0" Margin="0,0,4,0" />
                                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Normalized, Mode=OneWay}" Height="14" Margin="4,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Raw}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding Buttons}" Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ButtonReadingViewModel}">
                                                    <StackPanel Margin="2" Width="58" ContextMenu="{StaticResource ButtonControlMenu}"
                                                                AllowDrop="True" Drop="ButtonLamp_Drop"
                                                                PreviewMouseLeftButtonDown="ButtonLamp_PreviewMouseLeftButtonDown"
                                                                MouseMove="ButtonLamp_MouseMove">
                                                        <Image Source="{Binding ShownImage}" Width="40" Height="40" Margin="0,0,0,1"
                                                               ToolTip="The picture on this key's screen. Right-click to change or clear it, or drop a picture file here.">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShownImage}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <Border Style="{StaticResource ButtonLampStyle}" HorizontalAlignment="Center"
                                                                ToolTip="The button's number on this device. Right-click to remap it. On a Raw Input keyboard device, drag to reorder.">
                                                            <TextBlock Text="{Binding DisplayNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" />
                                                        </Border>
                                                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" FontSize="9" TextAlignment="Center"
                                                                 BorderThickness="0" Background="Transparent" Padding="0" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding Povs}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:PovReadingViewModel}">
                                                    <StackPanel Orientation="Horizontal" Margin="0,2" ContextMenu="{StaticResource PovControlMenu}">
                                                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                                                 BorderThickness="0" Background="Transparent" Padding="0"
                                                                 ToolTip="Right-click to remap this hat (whole, or one direction at a time)" />
                                                        <TextBlock Text=": " />
                                                        <TextBlock Text="{Binding DirectionText, Mode=OneWay}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                    Visibility="{Binding HiddenControls.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                            <TextBlock Text="Hidden:" VerticalAlignment="Center" Margin="0,0,4,0" FontStyle="Italic" FontSize="11" />
                                            <ComboBox Width="120" ItemsSource="{Binding HiddenControls}" SelectedItem="{Binding SelectedHiddenControl}"
                                                      SelectedIndex="0" Margin="0,0,4,0" FontSize="11" />
                                            <Button Content="Restore" Click="RestoreControl_Click" Padding="4,0" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- vJoy Output: what the mappings send right now -->
            <TabItem x:Name="OutputTab" Header="vJoy Output">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="8" Background="#F7F7F7">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="What your mappings are sending right now: the vJoy axes, buttons and hats a game sees, and the keyboard keys pressed. Move your controls to check them. Hover over anything to see what drives it." />
                            <TextBlock x:Name="OutputVJoyNote" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#B26A00" Visibility="Collapsed"
                                       Text="vJoy isn't installed, so games can't see this yet - it shows what they would see once it is." />
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Right" Width="260" BorderBrush="#CCCCCC" BorderThickness="1,0,0,0" Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Keys sent" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBlock DockPanel.Dock="Top" x:Name="OutputNoKeysText" TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                                       Text="None yet. Mappings only press keys while &quot;Keyboard keys on&quot; is ticked." />
                            <ListBox x:Name="RecentKeysList" ItemsSource="{Binding RecentKeys}" FontFamily="Consolas" BorderThickness="0"
                                     AutomationProperties.Name="Keys sent" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock x:Name="OutputEmptyText" Foreground="Gray" TextWrapping="Wrap" Visibility="Collapsed"
                                       Text="This profile doesn't send anything to vJoy yet. Right-click a control on Live Monitor and choose Remap to map it." />
                            <ItemsControl ItemsSource="{Binding VJoyOutputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:VJoyOutputDeviceViewModel}">
                                        <Border BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,8" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding Axes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:VJoyAxisOutputViewModel}">
                                                            <Grid Margin="0,2" ToolTip="{Binding DrivenBy}" AutomationProperties.Name="{Binding Name}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="90" />
                                                                    <ColumnDefinition Width="*" MaxWidth="400" />
                                                                    <ColumnDefinition Width="60" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Fill, Mode=OneWay}" Height="14" Margin="4,0" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Text}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Buttons}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:VJoyButtonOutputViewModel}">
                                                            <Border Style="{StaticResource ButtonLampStyle}" Width="30" ToolTip="{Binding DrivenBy}">
                                                                <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Hats}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:VJoyHatOutputViewModel}">
                                                            <StackPanel Orientation="Horizontal" Margin="0,2" ToolTip="{Binding DrivenBy}">
                                                                <TextBlock Text="{Binding Name}" Width="90" />
                                                                <TextBlock Text="{Binding DirectionText}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Layout: a background picture (e.g. a controls diagram) with control markers on it -->
            <TabItem x:Name="LayoutTab" Header="Layout">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="8" Background="#F7F7F7">
                        <WrapPanel>
                            <TextBlock Text="Page:" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox x:Name="LayoutPageCombo" Width="160" ItemsSource="{Binding LayoutPages}" DisplayMemberPath="Name"
                                      SelectionChanged="LayoutPageCombo_SelectionChanged" Margin="0,0,4,0" />
                            <TextBox x:Name="LayoutPageNameBox" Width="140" Margin="0,0,4,0" VerticalContentAlignment="Center"
                                     Text="{Binding SelectedItem.Name, ElementName=LayoutPageCombo, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Rename this page" />
                            <Button Content="New page" Click="LayoutNewPage_Click" Padding="8,2" Margin="0,0,4,0" />
                            <Button x:Name="LayoutDeletePageButton" Content="Delete page" Click="LayoutDeletePage_Click" Padding="8,2" Margin="0,0,16,0" />
                            <Button Content="Set background..." Click="LayoutSetBackground_Click" Padding="8,2" Margin="0,0,4,0"
                                    ToolTip="Load a picture of your controls (a manual's diagram, a photo, a schematic) to place control markers on. You can also drop a picture file onto the page." />
                            <Button x:Name="LayoutClearBackgroundButton" Content="Clear background" Click="LayoutClearBackground_Click" Padding="8,2" Margin="0,0,4,0" />
                            <Button x:Name="LayoutExportImageButton" Content="Export image..." Click="LayoutExportImage_Click" Padding="8,2" Margin="0,0,16,0"
                                    ToolTip="Save this page - picture, markers, mappings and text - as a PNG, e.g. to print as a reference card or use as a sim kneeboard page." />
                            <CheckBox x:Name="LayoutEditToggle" Content="Edit layout" VerticalAlignment="Center" Margin="0,0,8,0"
                                      Checked="LayoutEditToggle_Changed" Unchecked="LayoutEditToggle_Changed"
                                      ToolTip="Place controls and text on the picture and drag them into position. Untick to lock them in place - clicking a control then opens its remap editor." />
                            <Button x:Name="LayoutAddTextButton" Content="Add text" Click="LayoutAddText_Click" Padding="8,2"
                                    ToolTip="Put a free text label on the page (a title, a note, a name for part of the picture). Drag it by its ⠿ handle; right-click for size/delete." />
                        </WrapPanel>
                    </Border>

                    <!-- Palette of controls not yet on this page (edit mode only) -->
                    <Border x:Name="LayoutPalettePanel" DockPanel.Dock="Right" Width="230" Visibility="Collapsed"
                            BorderBrush="#CCCCCC" BorderThickness="1,0,0,0" Background="#FAFAFA">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="8" FontSize="11" Foreground="#444444"
                                       Text="Drag a control onto the picture to place it (or double-click it to drop it in the middle). Drag markers to move them; right-click one to take it off." />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LayoutPalette}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LayoutPaletteGroup}">
                                            <StackPanel Margin="8,4,8,8">
                                                <DockPanel Margin="0,0,0,2">
                                                    <Button DockPanel.Dock="Right" Content="Add all" Click="LayoutAddAll_Click" FontSize="10" Padding="4,0"
                                                            ToolTip="Put all of this device's remaining controls on the page in a grid, ready to drag into place" />
                                                    <TextBlock Text="{Binding DeviceLabel}" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:LayoutPaletteItem}">
                                                            <Border Padding="4,2" Margin="0,1" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3"
                                                                    Cursor="Hand"
                                                                    PreviewMouseLeftButtonDown="LayoutPaletteItem_PreviewMouseLeftButtonDown"
                                                                    MouseMove="LayoutPaletteItem_MouseMove">
                                                                <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Grid x:Name="LayoutArea" Background="#3A3A3A" ClipToBounds="True" AllowDrop="True"
                          SizeChanged="LayoutArea_SizeChanged" DragOver="LayoutArea_DragOver" Drop="LayoutArea_Drop">
                        <Image x:Name="LayoutBackgroundImage" Stretch="Uniform" Margin="16" />
                        <TextBlock x:Name="LayoutHintText" Foreground="#DDDDDD" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" IsHitTestVisible="False" />
                        <ItemsControl x:Name="LayoutMarkersControl" ItemsSource="{Binding LayoutItems}" Cursor="Hand">
                            <ItemsControl.Resources>
                                <!-- Free text label: plain text when locked; a drag handle + editable box while editing. -->
                                <DataTemplate DataType="{x:Type vm:LayoutTextViewModel}">
                                    <Border Background="#B0000000" CornerRadius="3" Padding="4,1" Cursor="Arrow" SizeChanged="LayoutItem_SizeChanged">
                                        <Border.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Bigger text" Click="LayoutTextBigger_Click" />
                                                <MenuItem Header="Smaller text" Click="LayoutTextSmaller_Click" />
                                                <Separator />
                                                <MenuItem Header="Delete text" Click="LayoutTextDelete_Click" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="White">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <DockPanel>
                                                <DockPanel.Style>
                                                    <Style TargetType="DockPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DockPanel.Style>
                                                <TextBlock Text="⠿" Foreground="White" FontSize="16" Cursor="SizeAll" VerticalAlignment="Center" Margin="0,0,4,0"
                                                           Background="Transparent" ToolTip="Drag to move"
                                                           MouseLeftButtonDown="LayoutItem_MouseLeftButtonDown"
                                                           MouseMove="LayoutItem_MouseMove"
                                                           MouseLeftButtonUp="LayoutItem_MouseLeftButtonUp" />
                                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontSize="{Binding FontSize}"
                                                         Foreground="White" Background="Transparent" CaretBrush="White" BorderBrush="#88FFFFFF"
                                                         BorderThickness="0,0,0,1" AcceptsReturn="True" MinWidth="40" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                                <!-- Control marker: lights up live, shows its mappings; click to remap. -->
                                <DataTemplate DataType="{x:Type vm:LayoutMarkerViewModel}">
                                    <Border CornerRadius="4" Padding="6,2" BorderThickness="1" BorderBrush="White" MinWidth="36"
                                            ToolTip="{Binding ToolTipText}"
                                            SizeChanged="LayoutItem_SizeChanged"
                                            MouseLeftButtonDown="LayoutItem_MouseLeftButtonDown"
                                            MouseMove="LayoutItem_MouseMove"
                                            MouseLeftButtonUp="LayoutItem_MouseLeftButtonUp">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E0202020" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="#F03AA655" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Remap..." Click="LayoutRemapMarker_Click" FontWeight="Bold" />
                                                <MenuItem Header="Take off this page" Click="LayoutRemoveMarker_Click" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding MappingText}" Foreground="#FFD27F" FontSize="10" HorizontalAlignment="Center"
                                                       Visibility="{Binding HasMapping, Converter={StaticResource BoolToVisibility}}" />
                                            <ProgressBar Height="4" Width="50" Minimum="0" Maximum="1" Value="{Binding AxisValue, Mode=OneWay}" Margin="0,2,0,1"
                                                         Visibility="{Binding IsAxis, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.Resources>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Calibration -->
            <TabItem Header="Calibration">
                <DataGrid ItemsSource="{Binding CalibrationRows}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Device" Binding="{Binding Device.Label}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Name" Binding="{Binding AxisVm.Label, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                        <DataGridTextColumn Header="Axis" Binding="{Binding Axis}" IsReadOnly="True" Width="80" />
                        <DataGridTextColumn Header="Raw" Binding="{Binding RawLive}" IsReadOnly="True" Width="60" />
                        <DataGridTextColumn Header="Normalized" Binding="{Binding NormalizedLive, StringFormat=F2}" IsReadOnly="True" Width="80" />
                        <DataGridTextColumn Header="Min" Binding="{Binding RawMin, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                        <DataGridTemplateColumn Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Set Min" Click="SetMinFromLive_Click" Padding="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Center" Binding="{Binding RawCenter, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                        <DataGridTemplateColumn Header="" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Set Center" Click="SetCenterFromLive_Click" Padding="4,0" ToolTip="Capture the current live raw value as center" />
                                        <Button Content="= Mid" Click="SetCenterFromMinMax_Click" Padding="4,0" Margin="4,0,0,0" ToolTip="Set center to the midpoint of Min and Max" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Max" Binding="{Binding RawMax, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                        <DataGridTemplateColumn Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Set Max" Click="SetMaxFromLive_Click" Padding="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Deadzone" Binding="{Binding DeadZone, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                        <DataGridTextColumn Header="Curve" Binding="{Binding Curve, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                        <DataGridCheckBoxColumn Header="Invert" Binding="{Binding Invert, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Mapping -->
            <!-- Mappings: everything mapped, one line each; changes go through the remap window -->
            <TabItem x:Name="MappingsTab" Header="Mappings">
                <DockPanel Margin="8">
                    <Expander DockPanel.Dock="Top" Header="What is vJoy, and how do I set this up? (click to expand)" Margin="0,0,0,8"
                              Background="#F7F7F7" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8">
                        <StackPanel Margin="4,8,4,4">
                            <TextBlock TextWrapping="Wrap" FontWeight="Bold" Text="What vJoy is" Margin="0,0,0,2" />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                vJoy is a separate driver (not part of this app) that creates fake joysticks. As far as Windows
                                and every game are concerned, a "vJoy device" looks and behaves exactly like a real USB joystick
                                plugged in - except nothing physical is attached. This app is what feeds it values, based on the
                                mappings you set up below. Games can't natively combine several separate physical devices (your
                                sticks, throttle, panel) into one controller; routing everything through one vJoy device is the trick.
                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" FontWeight="Bold" Text="One-time setup (outside this app)" Margin="0,0,0,2" />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                1. Install vJoy - on Windows 10/11 use the signed build from
                                <Hyperlink NavigateUri="https://github.com/BrunnerInnovation/vJoy/releases" RequestNavigate="Hyperlink_RequestNavigate">github.com/BrunnerInnovation/vJoy</Hyperlink>
                                (or 2.1.9.1 from
                                <Hyperlink NavigateUri="https://github.com/jshafer817/vJoy/releases" RequestNavigate="Hyperlink_RequestNavigate">github.com/jshafer817/vJoy</Hyperlink>
                                if that one won't install). The older SourceForge release often fails to install on Windows 11.
                                The status bar above shows whether this app can currently see it; restart the app after installing.
                                <LineBreak /><LineBreak />
                                2. Run "Configure vJoy" from the Start Menu (installed alongside the driver) and set how many
                                axes, buttons, and POVs vJoy device 1 should have. If unsure, enable all 8 axes and a generous
                                number of buttons (e.g. 32) - you can change this later.
                                <LineBreak /><LineBreak />
                                3. That's it for vJoy itself. Everything else happens in this app and in your game's control settings.
                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" FontWeight="Bold" Text="The vJoy device number (1-16)" Margin="0,0,0,2" />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                vJoy can create up to 16 of these fake joysticks at once, like plugging in 16 controllers. The
                                number just picks which one a mapping writes into. For almost everyone, just use device 1 for
                                everything - one virtual joystick with all your real controls combined onto it. You'd only need
                                more if you deliberately wanted separate virtual controllers for different purposes.
                            </TextBlock>

                            <TextBlock TextWrapping="Wrap" FontWeight="Bold" Text="Putting it together" Margin="0,0,0,2" />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                Each line below is a "mapping": this control on this physical device writes to this slot on this
                                vJoy device. Add one per control you want to use - e.g. your stick's X/Y axes, throttle lever,
                                rudder twist, and switch panel buttons - all onto vJoy device 1 ("Map all to vJoy..." on a device's
                                card in Live Monitor does a whole device in one go). Once you're done, open Windows' "Set up USB game controllers"
                                (search the Start Menu for it) to see and test-wiggle "vJoy Device" like any other controller
                                before jumping into a game. Finally, in your game's control bindings, bind to "vJoy Device"
                                instead of your physical hardware.
                            </TextBlock>
                        </StackPanel>
                    </Expander>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Left" Content="Add..." Click="AddMapping_Click" Padding="12,2" Margin="0,0,12,0" FontWeight="SemiBold"
                                ToolTip="Pick a control (or press it on your hardware) and choose what it does" />
                        <TextBlock DockPanel.Dock="Left" Text="Show:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="MappingDeviceFilterCombo" DockPanel.Dock="Left" Width="160" Margin="0,0,4,0"
                                  ItemsSource="{Binding MappingDeviceFilters}" SelectionChanged="MappingFilter_SelectionChanged" />
                        <ComboBox x:Name="MappingLayerFilterCombo" DockPanel.Dock="Left" Width="100" Margin="0,0,4,0"
                                  ItemsSource="{Binding MappingLayerFilters}" SelectionChanged="MappingFilter_SelectionChanged" />
                        <ComboBox x:Name="MappingTypeFilterCombo" DockPanel.Dock="Left" Width="100" Margin="0,0,12,0"
                                  ItemsSource="{Binding MappingTypeFilters}" SelectionChanged="MappingFilter_SelectionChanged" />
                        <TextBlock x:Name="MappingCountText" VerticalAlignment="Center" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="11" Foreground="#555555"
                               Text="Double-click a line (or click Change) to change it. Click a column header to sort. You can also remap by right-clicking a control on Live Monitor, or clicking a marker on the Layout tab." />

                    <DataGrid x:Name="MappingsGrid" ItemsSource="{Binding MappingRows}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6E6E6"
                              MouseDoubleClick="MappingsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="150" />
                            <DataGridTextColumn Header="Control" Binding="{Binding Control}" Width="150" />
                            <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="70" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" />
                            <DataGridTextColumn Header="Does" Binding="{Binding Output}" Width="*" />
                            <DataGridTemplateColumn Header="" Width="130" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Change" Click="ChangeMapping_Click" Padding="6,0" Margin="0,0,4,0" />
                                            <Button Content="Remove" Click="RemoveMapping_Click" Padding="6,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <!-- Profiles: every saved profile, and which profile goes with which game -->
            <TabItem x:Name="ProfilesTab" Header="Profiles">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="280" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Profiles" Padding="6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="11" Foreground="#444444"
                                       Text="A profile holds everything you set up: names, calibration, mappings, layout pages and key pictures. The active one saves automatically as you go. Double-click a profile to switch to it." />
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Name:" VerticalAlignment="Center" Width="45" />
                                    <Button DockPanel.Dock="Right" Content="Rename" Click="RenameProfile_Click" Padding="10,2" Margin="4,0,0,0" />
                                    <TextBox x:Name="ProfileRenameBox" KeyDown="ProfileRenameBox_KeyDown" VerticalContentAlignment="Center"
                                             ToolTip="Type a new name for the selected profile, then click Rename (or press Enter)." />
                                </DockPanel>
                                <WrapPanel>
                                    <Button x:Name="SwitchToProfileButton" Content="Switch to it" Click="SwitchToProfile_Click" Padding="10,2" Margin="0,0,4,4" FontWeight="SemiBold" />
                                    <Button Content="New" Click="NewProfile_Click" Padding="10,2" Margin="0,0,4,4"
                                            ToolTip="Start an empty profile and switch to it (the current one is saved first)." />
                                    <Button Content="Duplicate" Click="DuplicateProfile_Click" Padding="10,2" Margin="0,0,4,4"
                                            ToolTip="Copy the selected profile under a new name - e.g. to start a game's profile from your usual setup." />
                                    <Button x:Name="DeleteProfileButton" Content="Delete" Click="DeleteProfile_Click" Padding="10,2" Margin="0,0,12,4"
                                            ToolTip="Delete the selected profile (not the active one - switch away from it first)." />
                                    <Button Content="Export..." Click="ExportProfile_Click" Padding="10,2" Margin="0,0,4,4"
                                            ToolTip="Save the selected profile as a .json file anywhere - for backup or sharing." />
                                    <Button Content="Import..." Click="ImportProfile_Click" Padding="10,2" Margin="0,0,4,4"
                                            ToolTip="Add a profile from a .json file (e.g. one someone shared) to this list." />
                                    <Button Content="Backups..." Click="ProfileBackups_Click" Padding="10,2" Margin="0,0,4,4"
                                            ToolTip="Earlier versions of the selected profile, saved automatically - put one back if something went wrong." />
                                </WrapPanel>
                            </StackPanel>
                            <ListBox x:Name="ProfilesList" ItemsSource="{Binding ProfileItems}"
                                     SelectionChanged="ProfilesList_SelectionChanged" MouseDoubleClick="ProfilesList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="  active" Foreground="#2E7D32" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding UsedBy}" Foreground="Gray" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Profiles for games" Padding="6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="11" Foreground="#444444"
                                       Text="While one of these games is running, ClaudFlight switches to its profile automatically (checked every few seconds), and back to the profile you had before once the game closes. Changes you make meanwhile are saved into the game's profile." />
                            <TextBlock x:Name="GameStatusText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#2E7D32" FontWeight="SemiBold" />

                            <GroupBox DockPanel.Dock="Bottom" Header="Add a game" Padding="6" Margin="0,6,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="Game:" Width="60" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseGame_Click" Padding="6,0" Margin="4,0,0,0"
                                                ToolTip="Pick the game's .exe file" />
                                        <Button DockPanel.Dock="Right" Content="↻" Click="RefreshRunningPrograms_Click" Padding="6,0" Margin="4,0,0,0"
                                                ToolTip="Refresh the list of running programs" />
                                        <ComboBox x:Name="GameProcessCombo" IsEditable="True"
                                                  ToolTip="The game's program name without .exe (e.g. DCS, X-Plane, FlightSimulator). Programs running now are listed - start the game first to pick it here, or type the name, or browse for the .exe." />
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="Profile:" Width="60" VerticalAlignment="Center" />
                                        <ComboBox x:Name="GameProfileCombo" ItemsSource="{Binding ProfileNames}" />
                                    </DockPanel>
                                    <Button Content="Add" Click="AddGameProfile_Click" HorizontalAlignment="Left" Padding="14,2" Margin="60,6,0,0" />
                                </StackPanel>
                            </GroupBox>

                            <Grid>
                                <TextBlock x:Name="NoGameEntriesText" Text="No games yet - add one below." FontStyle="Italic" Foreground="Gray" Margin="2" />
                                <ItemsControl ItemsSource="{Binding GameEntryRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <Button DockPanel.Dock="Right" Content="Remove" Click="RemoveGameProfile_Click" Padding="8,0" />
                                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                                    <Run Text="{Binding Entry.ProcessName, Mode=OneWay}" FontWeight="Bold" />
                                                    <Run Text="  uses  " Foreground="Gray" />
                                                    <Run Text="{Binding ProfileText, Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
