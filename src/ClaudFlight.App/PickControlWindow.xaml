<Window x:Class="ClaudFlight.App.PickControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a control" Width="420" Height="480" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11" Foreground="#444444"
                   Text="Press a button, push a hat or move an axis on your hardware to pick it - or choose it from the list. A hat's directions and an axis's ends (+/−) can each be mapped on their own." />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Device:" Width="60" VerticalAlignment="Center" />
            <ComboBox x:Name="DeviceCombo" DisplayMemberPath="Label" SelectionChanged="DeviceCombo_SelectionChanged" />
        </DockPanel>
        <TextBlock x:Name="DetectedText" DockPanel.Dock="Top" Foreground="#2E7D32" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Remap it..." IsDefault="True" Click="Ok_Click" Padding="14,2" Margin="0,0,6,0" />
            <Button Content="Cancel" IsCancel="True" Padding="14,2" />
        </StackPanel>
        <ListBox x:Name="ControlList" DisplayMemberPath="Display" MouseDoubleClick="ControlList_MouseDoubleClick" />
    </DockPanel>
</Window>
