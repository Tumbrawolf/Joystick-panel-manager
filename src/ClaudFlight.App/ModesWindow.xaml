<Window x:Class="ClaudFlight.App.ModesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modes" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#444444" Margin="0,0,0,8"
                   Text="A mode is a set of mappings picked by a switch - e.g. Nav, Combat and Landing on a 3-way switch, each position picking one. While a mode's switch is on, any input with mappings for that mode uses those instead of its usual ones; inputs without any keep their usual mappings. With no mode's switch on, only the usual (any-mode) mappings apply. Give a mapping its mode in its remap window." />
        <ListBox x:Name="ModesList" Height="120" DisplayMemberPath="Display" SelectionChanged="ModesList_SelectionChanged"
                 AutomationProperties.Name="Modes" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button x:Name="ChangeSwitchButton" Content="Change switch..." Click="ChangeSwitch_Click" Padding="8,2" Margin="0,0,4,0" IsEnabled="False"
                    ToolTip="Pick another control to select the chosen mode; its mappings stay as they are." />
            <Button x:Name="RenameButton" Content="Rename to the name below" Click="Rename_Click" Padding="8,2" Margin="0,0,4,0" IsEnabled="False" />
            <Button x:Name="RemoveModeButton" Content="Remove" Click="RemoveMode_Click" Padding="8,2" IsEnabled="False"
                    ToolTip="Remove the chosen mode and its mappings." />
        </StackPanel>

        <GroupBox Header="Add a mode" Padding="6" Margin="0,8,0,0">
            <StackPanel>
                <DockPanel Margin="0,2">
                    <TextBlock Text="Name:" Width="70" VerticalAlignment="Center" />
                    <TextBox x:Name="ModeNameBox" AutomationProperties.Name="Mode name" />
                </DockPanel>
                <DockPanel Margin="0,2">
                    <TextBlock Text="Switch:" Width="70" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Pick..." Click="PickSwitch_Click" Padding="8,0" Margin="4,0,0,0"
                            ToolTip="Pick the button, hat direction or axis end that selects this mode (or press it on your hardware)." />
                    <TextBlock x:Name="PickedSwitchText" Text="none picked yet" VerticalAlignment="Center" Foreground="Gray" />
                </DockPanel>
                <Button x:Name="AddModeButton" Content="Add" Click="AddMode_Click" HorizontalAlignment="Left" Padding="14,2" Margin="70,6,0,0" />
            </StackPanel>
        </GroupBox>

        <CheckBox x:Name="AnnounceCheck" Content="Say the mode's name aloud when it changes" Margin="0,8,0,0"
                  Checked="Announce_Changed" Unchecked="Announce_Changed" />
        <Button Content="Close" IsCancel="True" HorizontalAlignment="Right" Padding="14,2" Margin="0,10,0,0" Click="Close_Click" />
    </StackPanel>
</Window>
