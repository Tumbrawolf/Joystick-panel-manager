<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ClaudFlight.Core\ClaudFlight.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms pulls in global usings for these that collide with WPF's own
         System.Windows/System.Windows.Input types (Application, Binding, Point, etc.).
         We only need WinForms for the tray icon (NotifyIcon/ContextMenuStrip), referenced
         with fully-qualified names, so drop the global usings rather than the whole feature. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
